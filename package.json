{
  "name": "rohan-pathak-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,json,html}\" \"*.json\" \"README.md\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,json,html}\" \"*.json\" \"README.md\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
